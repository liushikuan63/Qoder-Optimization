{
  "hooks": {
    "UserPromptSubmit": [
    { "hooks": [ { "type": "command", "command": "<node> \"<客户端目录>/scripts/rules-reminder.js\" --client-root \"<客户端目录>\" --workflow-mode model", "timeout": 10 } ] },
    { "hooks": [ { "type": "command", "command": "<node> \"<客户端目录>/scripts/session-budget.js\"", "timeout": 10 } ] },
    { "hooks": [ { "type": "command", "command": "<node> \"<客户端目录>/scripts/fact-ledger.cjs\" --hook", "timeout": 10 } ] }
    ],
    "Stop": [
    { "hooks": [ { "type": "command", "command": "<node> \"<客户端目录>/scripts/stop-gate.js\"", "timeout": 10 } ] }
    ],
    "SessionStart": [
    { "hooks": [ { "type": "command", "command": "<node> \"<客户端目录>/scripts/global-config-guard.js\"", "timeout": 15 } ] },
    { "hooks": [ { "type": "command", "command": "<node> \"<客户端目录>/scripts/session-budget.js\"", "timeout": 10 } ] }
    ],
    "PreToolUse": [
    { "hooks": [ { "type": "command", "command": "<node> \"<客户端目录>/scripts/edit-guard.js\"", "timeout": 10 } ] },
    { "hooks": [ { "type": "command", "command": "<node> \"<客户端目录>/scripts/huge-output-guard.js\"", "timeout": 10 } ] },
    { "hooks": [ { "type": "command", "command": "<node> \"<客户端目录>/scripts/commit-scope-guard.js\"", "timeout": 10 } ] },
    { "hooks": [ { "type": "command", "command": "<node> \"<客户端目录>/scripts/cua-cursor-guard.js\"", "timeout": 10 } ] },
    { "hooks": [ { "type": "command", "command": "<node> \"<客户端目录>/scripts/risky-match-guard.js\"", "timeout": 10 } ] },
    { "matcher": "^Bash$", "hooks": [ { "type": "command", "command": "<node> \"<客户端目录>/scripts/win-path-guard.js\"", "timeout": 10 } ] }
    ],
    "PostToolUse": [
    { "hooks": [ { "type": "command", "command": "<node> \"<客户端目录>/scripts/cua-cursor-guard.js\"", "timeout": 10 } ] },
    { "hooks": [ { "type": "command", "command": "<node> \"<客户端目录>/scripts/auth-lock-guard.js\"", "timeout": 10 } ] },
    { "matcher": "^Bash$", "hooks": [ { "type": "command", "command": "<node> \"<客户端目录>/scripts/attempt-lock-guard.js\"", "timeout": 10 } ] },
    { "matcher": "^Bash$|^Read$|^Agent$|^Task$|mcp_call", "hooks": [ { "type": "command", "command": "<node> \"<客户端目录>/scripts/tool-payload-guard.js\"", "timeout": 10 } ] }
    ]
  }
}
